# Deploy sau reverse proxy dưới subpath (vd /liveness). Đổi giá trị phải build lại.
NEXT_PUBLIC_BASE_PATH=

# URL gốc khi deploy (kèm basePath), dùng cho og:image / canonical
NEXT_PUBLIC_SITE_URL=

# MediaPipe — mặc định lấy từ jsDelivr / Google Storage, đổi nếu muốn self-host
NEXT_PUBLIC_MEDIAPIPE_WASM_ROOT=
NEXT_PUBLIC_MEDIAPIPE_FACE_MODEL_URL=

# TVWebSDK (Trusting Social) — assetRoot/resourceRoot do vendor cấp theo license
NEXT_PUBLIC_TVWEB_SDK_URL=
NEXT_PUBLIC_TVWEB_ASSET_ROOT=
NEXT_PUBLIC_TVWEB_RESOURCE_ROOT=
